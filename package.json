{
  "name": "resident",
  "version": "0.5.0",
  "license": "UNLICENSED",
  "packageManager": "yarn@4.11.0",
  "engines": {
    "node": "^24.0.0"
  },
  "main": "./dist/lib.umd.js",
  "module": "./dist/lib.es.js",
  "types": "./dist/lib.umd.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib.umd.d.ts",
      "import": "./dist/lib.es.js",
      "require": "./dist/lib.umd.js"
    }
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2"
  },
  "dependenciesMeta": {
    "bcrypt": {
      "unplugged": true
    }
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.12.0",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "codedocs": "^0.18.0",
    "eslint": "8.57.1",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "2.8.1",
    "react": "^17.0.0",
    "react-dom": "^17.0.0",
    "react-router-dom": "^6.23.1",
    "tsc-alias": "^1.8.10",
    "typescript": "5.9.3",
    "vite": "^5.3.1",
    "vite-plugin-commonjs-externals": "^0.1.4",
    "vitest": "^1.6.0"
  },
  "scripts": {
    "all": "yarn install --immutable && yarn build && yarn fix && yarn check:types && yarn test",
    "build": "rm -rf dist && yarn build:lib && yarn build:types",
    "build:lib": "vite build --config vite.lib.config.js --mode development",
    "build:types": "tsc --declaration --emitDeclarationOnly -p tsconfig.dist.json --skipLibCheck && tsc-alias -p tsconfig.json && mv dist/index.d.ts dist/lib.umd.d.ts",
    "check:format": "prettier --check --ignore-path .gitignore .",
    "check:lint": "eslint --ignore-path .gitignore --no-error-on-unmatched-pattern .",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "confgen": "npx confgen@latest @lib dist:lib --name Resident yarn vite vitest eslint prettier git githubActions codespaces codedocs typescript node:crypto",
    "fix": "yarn fix:lint && yarn fix:format",
    "fix:format": "prettier --write --ignore-path .gitignore .",
    "fix:lint": "eslint --ignore-path .gitignore --no-error-on-unmatched-pattern . --fix",
    "test": "vitest run --config vite.test.config.js",
    "watch:test": "vitest watch --config vite.test.config.js"
  }
}
